name: Build My TV Launcher

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Install Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Setup Gradle
        uses: gradle/actions/setup-gradle@v4

      - name: Extract project ZIP
        shell: bash
        run: |
          set -euo pipefail
          ZIP_FILE="$(find . -maxdepth 1 -type f -name 'MyTVLauncher-tvOS-Offline-Video-*.zip' -print -quit)"
          if [ -z "$ZIP_FILE" ]; then
            echo "Could not find MyTVLauncher-tvOS-Offline-Video-*.zip in the repository root."
            echo "Upload the project ZIP to the top level of the repository."
            exit 1
          fi
          mkdir -p buildsrc
          unzip -q "$ZIP_FILE" -d buildsrc
          PROJECT_DIR="buildsrc/MyTVLauncher"
          if [ ! -f "$PROJECT_DIR/settings.gradle.kts" ] || [ ! -d "$PROJECT_DIR/app" ]; then
            echo "The ZIP does not contain the expected MyTVLauncher project structure."
            find buildsrc -maxdepth 3 -type f | sort
            exit 1
          fi
          echo "PROJECT_DIR=$PROJECT_DIR" >> "$GITHUB_ENV"

      - name: Build Android APK
        run: gradle -p "$PROJECT_DIR" :app:assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: MyTVLauncher-debug
          path: buildsrc/MyTVLauncher/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error